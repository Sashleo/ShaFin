# ── ShaFin environment variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your own values. Never commit .env.

# Session secret, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=generate-a-64-char-random-string-here

# Database encryption password (SQLCipher), at least 12 characters. If you lose it,
# the database and its backups cannot be opened.
DB_MASTER_PASSWORD=set-a-strong-password-here

# Optional
DEBUG=false
SESSION_EXPIRE_HOURS=2
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# A second folder (inside the container) that each daily backup is also copied to.
BACKUP_COPY_DIR=
# Lets the first-run owner account be created from a non-local address.
ADMIN_BOOTSTRAP_TOKEN=
